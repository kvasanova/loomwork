{
  "description": "Loomwork doctrine at Codex session start and the close-out gate for explicit skill invocations.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/close-out-gate.sh\"",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/doctrine-gate.sh\"",
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
